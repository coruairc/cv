---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const cvPdf = `${base}cv.pdf`;
const email = 'ceino1995@gmail.com';
const linkedIn = 'https://www.linkedin.com/in/c%C3%A9in-o-rourke-ba574910a/';

const nav = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
  { href: '#languages', label: 'Languages' },
  { href: '#contact', label: 'Contact' },
];

const experience = [
  {
    dates: '01/2025 – Present',
    title: 'Software Developer — IBM Maximo Project',
    company: 'Volkswagen Group Digital Solutions',
    meta: 'Automotive / Enterprise Asset Management',
    bullets: [
      'Automation scripts for testing, validation, and support workflows',
      'Functional and technical Maximo testing',
      'OpenShift monitoring with Grafana, Prometheus, and Loki',
      'Defect analysis and test coverage improvements',
    ],
    tech: ['IBM Maximo', 'Python', 'Bash', 'OpenShift', 'Grafana', 'Prometheus', 'Loki', 'GitLab', 'Linux'],
  },
  {
    dates: '01/2024 – 12/2024',
    title: 'Software Developer — Virtual VIN Ordering',
    company: 'Volkswagen Group IT Solutions',
    meta: 'Automotive',
    bullets: [
      'TypeScript frontend and Java backend for virtual VIN ordering',
      'API integration and stakeholder requirements management',
      'Support for automotive testing workflows',
    ],
    tech: ['TypeScript', 'Java', 'REST APIs', 'GitLab', 'Linux', 'Automotive Testing'],
  },
  {
    dates: '08/2021 – 12/2023',
    title: 'Software Developer / Engineer / Test Automation',
    company: 'Volkswagen Group IT Solutions',
    meta: 'Automotive',
    bullets: [
      'E2E, API, frontend, and mobile automation',
      'ECU simulation and signal manipulation',
      'Web-GUI tooling for test and diagnostics workflows',
      'Linux/virtualisation infrastructure and 24/7 test-result databases',
    ],
    tech: ['PHP', 'SQL', 'MariaDB', 'Python', 'Bash', 'Apache', 'Selenium', 'Appium', 'GitLab', 'Linux', 'ODIS', 'CPtool'],
  },
  {
    dates: '10/2018 – 07/2021',
    title: 'Technology Consultant',
    company: 'AKKA DNO GmbH',
    meta: 'Automotive consulting',
    bullets: [
      'Swagger API requirements and JSON scripting',
      'Client presentations and mobile online services testing',
      'Database work and ECU diagnostics support',
    ],
    tech: ['Swagger', 'JSON', 'APIs', 'Databases', 'ECU Diagnostics'],
  },
  {
    dates: '09/2018 – 10/2018',
    title: 'Graduate Engineer',
    company: 'AKKAdemy Switzerland',
    meta: 'Graduate program',
    bullets: ['Intensive graduate engineering induction and project work'],
    tech: [],
  },
];

const skillGroups = [
  {
    name: 'Programming',
    items: ['Python', 'Bash', 'TypeScript', 'Java', 'PHP', 'C', 'C#', 'C++', 'SQL', 'JSON'],
  },
  {
    name: 'Testing',
    items: ['E2E', 'API', 'Frontend/App', 'Selenium', 'Appium'],
  },
  {
    name: 'Automotive / ECU',
    items: ['Diagnostics', 'Signal simulation', 'ODIS', 'CPtool'],
  },
  {
    name: 'Infra / Monitoring',
    items: ['Linux', 'Apache', 'Virtualisation', 'GitLab', 'OpenShift', 'Grafana', 'Prometheus', 'Loki'],
  },
  {
    name: 'Databases',
    items: ['MariaDB', 'SQL'],
  },
];

const education = [
  {
    dates: '2018 – 2019',
    title: 'Graduate Engineer Program',
    place: 'AKKAdemy Switzerland',
  },
  {
    dates: '2014 – 2018',
    title: 'Computer Science International',
    place: 'DIT / Hochschule Darmstadt',
  },
  {
    dates: '2008 – 2014',
    title: 'Leaving Certificate',
    place: 'De La Salle College Churchtown, Ireland',
  },
];

const languages = [
  { name: 'English', level: 'Mother tongue' },
  { name: 'German', level: 'B1' },
];
---

<Layout>
  <header class="sticky top-0 z-50 border-b border-noir-border/80 bg-noir-bg/90 backdrop-blur-md">
    <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6" aria-label="Primary">
      <a href={`${base}`} class="font-mono text-sm font-semibold text-cyan-accent hover:text-cyan-accent/90">
        <span class="text-amber-accent">~/</span>cein
      </a>
      <ul class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2">
        {nav.map((item) => (
          <li>
            <a class="nav-link" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </header>

  <main id="main" class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
    <!-- Hero -->
    <section id="about" class="mb-20 scroll-mt-24" aria-labelledby="hero-heading">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.25em] text-amber-accent">Software Developer</p>
      <h1 id="hero-heading" class="mb-4 text-4xl font-semibold tracking-tight text-slate-100 sm:text-5xl">
        Céin O’Rourke
      </h1>
      <p class="mb-8 max-w-2xl text-lg leading-relaxed text-noir-muted">
        Software Developer with experience in automotive software, API/E2E testing, ECU communication,
        Linux-based test infrastructure, databases, Web-GUI development, automation scripting, and monitoring.
        Practical background in requirements management, automated testing, simulation tooling, and maintaining
        reliable 24/7 test-result systems.
      </p>
      <div class="flex flex-wrap gap-3">
        <a class="btn-primary" href={cvPdf} download="Cein-ORourke-CV.pdf">
          <span aria-hidden="true">↓</span> Download CV
        </a>
        <a class="btn-ghost" href={`mailto:${email}`}>Email</a>
        <a class="btn-ghost" href={linkedIn} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="mb-20 scroll-mt-24" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="section-heading">// Experience</h2>
      <ol class="relative">
        {experience.map((role) => (
          <li class="timeline-item">
            <span class="timeline-dot" aria-hidden="true"></span>
            <div class="rounded-lg border border-noir-border bg-noir-surface/60 p-5 shadow-glow/50">
              <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="text-lg font-semibold text-slate-100">{role.title}</h3>
                <time class="font-mono text-xs text-amber-accent">{role.dates}</time>
              </div>
              <p class="mb-1 font-mono text-sm text-cyan-accent">{role.company}</p>
              <p class="mb-4 font-mono text-xs text-noir-muted">{role.meta}</p>
              <ul class="mb-4 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-slate-300">
                {role.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              {role.tech.length > 0 && (
                <div class="flex flex-wrap gap-2" aria-label="Technologies">
                  {role.tech.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Skills -->
    <section id="skills" class="mb-20 scroll-mt-24" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="section-heading">// Skills</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {skillGroups.map((group) => (
          <div class="rounded-lg border border-noir-border bg-noir-surface/60 p-5">
            <h3 class="mb-3 font-mono text-sm text-amber-accent">{group.name}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="chip">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section id="education" class="mb-20 scroll-mt-24" aria-labelledby="education-heading">
      <h2 id="education-heading" class="section-heading">// Education</h2>
      <ul class="space-y-4">
        {education.map((ed) => (
          <li class="rounded-lg border border-noir-border bg-noir-surface/60 p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-base font-semibold text-slate-100">{ed.title}</h3>
              <time class="font-mono text-xs text-amber-accent">{ed.dates}</time>
            </div>
            <p class="mt-1 font-mono text-sm text-cyan-accent">{ed.place}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Languages -->
    <section id="languages" class="mb-20 scroll-mt-24" aria-labelledby="languages-heading">
      <h2 id="languages-heading" class="section-heading">// Languages</h2>
      <ul class="flex flex-wrap gap-4">
        {languages.map((lang) => (
          <li class="rounded-lg border border-noir-border bg-noir-surface/60 px-5 py-4">
            <span class="block text-slate-100">{lang.name}</span>
            <span class="font-mono text-xs text-noir-muted">{lang.level}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Contact -->
    <section id="contact" class="scroll-mt-24" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="section-heading">// Contact</h2>
      <div class="rounded-lg border border-noir-border bg-noir-surface/60 p-6 shadow-glow">
        <p class="mb-4 text-noir-muted">Get in touch — email or LinkedIn only.</p>
        <ul class="space-y-3 font-mono text-sm">
          <li>
            <span class="text-amber-accent">email:</span>{' '}
            <a class="text-cyan-accent hover:underline" href={`mailto:${email}`}>{email}</a>
          </li>
          <li>
            <span class="text-amber-accent">linkedin:</span>{' '}
            <a class="text-cyan-accent hover:underline" href={linkedIn} target="_blank" rel="noopener noreferrer">
              linkedin.com/in/céin-o-rourke-ba574910a
            </a>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="border-t border-noir-border/80 py-8">
    <div class="mx-auto max-w-5xl px-4 text-center font-mono text-xs text-noir-muted sm:px-6">
      <p>© {new Date().getFullYear()} Céin O’Rourke · Built with Astro + Tailwind</p>
    </div>
  </footer>
</Layout>
